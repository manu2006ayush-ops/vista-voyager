# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/vista_voyager

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRE=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Optional: External AI provider key (for smarter chatbot).
# Leave blank to use the built-in rule-based AI engine.
AI_PROVIDER_API_KEY=
